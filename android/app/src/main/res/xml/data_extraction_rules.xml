<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: back up and transfer everything except the coach settings (the passphrase stays on the phone). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="coach.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="coach.xml" />
    </device-transfer>
</data-extraction-rules>
