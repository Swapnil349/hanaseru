# Copy to .env (never commit it) or set these in your host's dashboard.
ANTHROPIC_API_KEY=sk-ant-...
# Secret passphrase the app sends as a Bearer token (at least 16 characters; you type the same one in the app).
APP_TOKEN=
PORT=8787
# Optional overrides
# COACH_MODEL=claude-opus-5-5   (or claude-sonnet-5-5 / claude-haiku-4-5 for lower cost)
# COACH_EFFORT=low
# COACH_MOCK=1
